set $mod Mod4

font pango:Meslo LGM Nerd Font 9

exec --no-startup-id feh --bg-fill "$(cat ~/.cache/wal/wal)"
exec --no-startup-id date +%s > /tmp/network_event_timestamp
exec --no-startup-id betterlockscreen -u "$(cat ~/.cache/wal/wal)" --fx none
exec --no-startup-id xrdb -merge ~/.Xresources
exec --no-startup-id redshift
exec --no-startup-id udiskie
exec --no-startup-id libinput-gestures
exec --no-startup-id setxkbmap -option ctrl:nocaps
exec --no-startup-id xcape -e 'Control_L=Escape'
exec_always --no-startup-id sh -c 'MODE="$(<~/.config/mode)"; "$HOME/.config/i3/scripts/modes.sh" ${MODE}'
exec_always --no-startup-id sh -c 'MODE="$(<~/.config/mode)"; picom --config "$HOME/.config/picom/${MODE}.conf"'
exec_always --no-startup-id ~/.config/i3/scripts/monitors.sh
exec --no-startup-id xss-lock --transfer-sleep-lock -- betterlockscreen -l

exec --no-startup-id sh -c 'id=$(xinput list | grep -i touchpad | awk "{print \$6}" | cut -d= -f2); \
xinput set-prop "$id" "libinput Tapping Enabled" 1; \
xinput set-prop "$id" "libinput Natural Scrolling Enabled" 1'

bindsym XF86AudioRaiseVolume exec --no-startup-id bash -c "pactl set-sink-mute @DEFAULT_SINK@ false && pamixer -i 5"
bindsym XF86AudioLowerVolume exec --no-startup-id bash -c "pactl set-sink-mute @DEFAULT_SINK@ false && pamixer -d 5"
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/scripts/brightness.sh -d
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/i3/scripts/brightness.sh -i

#floating_modifier $mod
#tiling_drag modifier titlebar

for_window [class=".*"] border pixel 3
smart_borders on

bindsym $mod+Return exec kitty
bindsym $mod+t exec kitty -e htop
bindsym $mod+b exec firefox
bindsym $mod+y exec --no-startup-id ~/.config/i3/scripts/yazi-launcher.sh

bindsym $mod+q kill
bindsym $mod+Delete exec betterlockscreen -l

bindsym $mod+Control+Right exec playerctl next
bindsym $mod+Control+Left exec playerctl previous
bindsym $mod+Control+Up exec pamixer -i 5
bindsym $mod+Control+Down exec pamixer -d 5
bindsym $mod+Control+Return exec ~/.config/polybar/scripts/playerctl.sh --play-pause

bindcode $mod+40 exec ~/.config/rofi/launcher.sh

bindsym Print exec --no-startup-id sh -c 'maim -s "$HOME/Pictures/Screenshots/screenshot_$(date +%s).png" && notify-send "Screenshot saved" "You can find it in the Pictures/Screenshots folder"'
bindsym $mod+Print exec --no-startup-id sh -c 'maim "$HOME/Pictures/Screenshots/screenshot_$(date +%s).png" && notify-send "Screenshot saved" "You can find it in the Pictures/Screenshots folder"'
bindsym F9 exec --no-startup-id sh -c "~/.cargo/bin/xcolor | tr -d '\n' | xclip -selection clipboard && notify-send 'Color copied to clipboard'"

bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h split h

bindsym $mod+v split v

bindsym $mod+f fullscreen toggle

bindsym $mod+m exec --no-startup-id ~/.config/rofi/powermenu.sh

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
for_window [class="^(Display|feh)$"] floating enable

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+w exec --no-startup-id ~/.config/wal/service.sh && feh --bg-fill "$(cat ~/.cache/wal/wal)" && notify-send 'Walpaper changed' 'A random walpaper was choosen and the theam was changed'

bindsym $mod+Control+1 exec ~/.config/i3/scripts/modes.sh showy
bindsym $mod+Control+2 exec ~/.config/i3/scripts/modes.sh focus

bindsym $mod+Control+b exec ~/.config/i3/scripts/monitors.sh 1
bindsym $mod+Control+m exec ~/.config/i3/scripts/monitors.sh 2
bindsym $mod+Control+l exec ~/.config/i3/scripts/monitors.sh 3

mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"


set_from_resource $fg i3wm.color7 #f0f0f0
set_from_resource $bg i3wm.color0 #f0f0f0
set_from_resource $color1 i3wm.color1 #f0f0f0
set_from_resource $color2 i3wm.color2 #f0f0f0
set_from_resource $color3 i3wm.color3 #f0f0f0
set_from_resource $color4 i3wm.color4 #f0f0f0
set_from_resource $color5 i3wm.color5 #f0f0f0
set_from_resource $color6 i3wm.color6 #f0f0f0
set_from_resource $color7 i3wm.color7 #f0f0f0
set_from_resource $color8 i3wm.color8 #f0f0f0

# class                 border   backgr. text    indicator child_border
client.focused          $color5  $color5 $bg     $color6   $color5
client.focused_inactive $color8  $bg     $fg     $color6   $color8
client.unfocused        $color8  $bg     $fg     $color6   $color8
client.urgent           $color3  $bg     $color3 $color8   $color3
client.placeholder      $color8  $bg     $fg     $color8   $color8
client.background       $bg

