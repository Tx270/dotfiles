/*****----- Configuration -----*****/
configuration {
    show-icons:                 false;
}

/*****----- Global Properties -----*****/
@import "~/.cache/wal/colors-rofi-dark.rasi"

/*****----- Main Window -----*****/
window {
    /* properties for window widget */
    transparency:                "real";
    width:                       400px;

    /* properties for all widgets */
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               20px;
    border-color:                @active-background;
    cursor:                      "default";
    font:                        "JetBrainsMono Nerd Font Propo 11";
    background-color:            rgba(46,52,64,0.9);
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    margin:                      0px;
    padding:                     25px 5px 25px 25px;
    border:                      1px solid;
    border-radius:               20px;
    border-color:                @active-background;
    background-color:            transparent;
    children:                    [ "listview" ];
}

/*****----- Listview -----*****/
listview {
    columns:                     1;
    lines:                       3;
    cycle:                       true;
    layout:                      vertical;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     15px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @active-background;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     10px;
    border-radius:               20px;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    font:                        "JetBrainsMono Nerd Font Propo bold 11";
}

element.normal.normal, element.alternate.normal {
  background-color:              transparent;
}

element.selected.normal {
    background-color:            @active-background;
}

element.normal.active, element.alternate.active {
    background-color:            transparent;
    border:                      1px solid;
    border-color:                @active-background;
    border-radius:               20px;
  }
